{
  "name": "reelbot-ios",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "build:ios:dev": "npx eas-cli build --platform ios --profile development",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "credentials:ios": "npx eas-cli credentials --platform ios",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "submit:ios": "npx eas-cli submit --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-background-task": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-share-extension": "^5.0.6",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-shared-group-preferences": "^1.1.24"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-share-extension",
          "react-native-shared-group-preferences"
        ]
      }
    }
  }
}
